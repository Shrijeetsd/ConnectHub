<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505">

    <LinearLayout
        android:id="@+id/loginLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_margin="28dp"
        android:background="@drawable/glass_card_bg"
        android:orientation="vertical"
        android:padding="30dp"
        android:visibility="visible">

        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="center"
            android:src="@drawable/app_logo"
            android:layout_marginBottom="24dp"
            android:contentDescription="App Logo"
            android:background="@drawable/logo_frame"
            android:padding="12dp"
            android:elevation="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONNECTHUB ACCESS"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:letterSpacing="0.1"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ConnectHub Mobile v2.0"
            android:textColor="#475569"
            android:textSize="12sp"
            android:layout_gravity="center"
            android:layout_marginBottom="36dp"/>

        <EditText
            android:id="@+id/usernameInput"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:hint="Terminal ID"
            android:textColor="#FFFFFF"
            android:textColorHint="#334155"
            android:paddingLeft="18dp"
            android:background="@drawable/input_field_bg"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:hint="Access Key"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#334155"
            android:paddingLeft="18dp"
            android:background="@drawable/input_field_bg"
            android:layout_marginBottom="28dp"/>

        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="AUTHORIZE"
            android:textStyle="bold"
            android:backgroundTint="#6366F1"
            android:textAllCaps="true"
            app:cornerRadius="14dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SECURE AUTH OPTIONS"
            android:textColor="#1E293B"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginVertical="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/googleLoginButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="GOOGLE"
                android:layout_marginEnd="5dp"
                android:textColor="#FFFFFF"
                app:strokeColor="#1E293B" />

            <Button
                android:id="@+id/otpLoginButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="OTP"
                android:layout_marginStart="5dp"
                android:textColor="#FFFFFF"
                app:strokeColor="#1E293B" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dashboardLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="24dp"
        android:background="#050505">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONNECTHUB MONITOR"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:layout_marginBottom="32dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card_bg"
            android:padding="24dp"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONNECTION STATUS"
                    android:textColor="#475569"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
                <View
                    android:id="@+id/pulseDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/pulse_dot"/>
            </RelativeLayout>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENCRYPTED &amp; ACTIVE"
                android:textColor="#10B981"
                android:textSize="20sp"
                android:layout_marginTop="8dp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E293B"
                android:layout_marginVertical="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live streams are being redirected to your Web Console. Do not close this application."
                android:textColor="#64748B"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>

        <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

        <Button
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="TERMINATE CONNECTION"
            android:textColor="#FFFFFF"
            android:backgroundTint="#EF4444"
            app:cornerRadius="12dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>

</RelativeLayout>