<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505">

    <!-- ===== LOGIN SCREEN ===== -->
    <LinearLayout
        android:id="@+id/loginLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginHorizontal="28dp"
        android:background="@drawable/login_card_bg"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="visible">

        <!-- App Icon -->
        <FrameLayout
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="center"
            android:layout_marginBottom="28dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/logo_frame"
                android:src="@drawable/app_logo"
                android:scaleType="centerInside"
                android:padding="15dp"
                android:elevation="6dp"
                android:contentDescription="ConnectHub Logo" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONNECTHUB"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_gravity="center"
            android:layout_marginBottom="6dp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Secure Access Gateway"
            android:textColor="#8898C8"
            android:textSize="14sp"
            android:layout_gravity="center"
            android:layout_marginBottom="40dp" />

        <!-- Username Field -->
        <EditText
            android:id="@+id/usernameInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Username"
            android:textColor="#FFFFFF"
            android:textColorHint="#5A6490"
            android:textSize="15sp"
            android:paddingHorizontal="18dp"
            android:background="@drawable/input_field_bg"
            android:inputType="text"
            android:layout_marginBottom="14dp"
            android:singleLine="true" />

        <!-- Password Field -->
        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Password"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#5A6490"
            android:textSize="15sp"
            android:paddingHorizontal="18dp"
            android:background="@drawable/input_field_bg"
            android:layout_marginBottom="28dp"
            android:singleLine="true" />

        <!-- Login Button -->
        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="LOGIN"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:background="@drawable/login_btn_bg"
            android:stateListAnimator="@null" />

    </LinearLayout>



    <LinearLayout
        android:id="@+id/dashboardLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#050505">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="#0F172A">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONNECTHUB PORTAL"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_centerVertical="true"/>

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E293B"/>

        <WebView
            android:id="@+id/portalWebView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#050505"/>

        <LinearLayout
            android:id="@+id/statusStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="#0F172A"
            android:gravity="center">
            <View
                android:id="@+id/pulseDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/pulse_dot"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENCRYPTED &amp; ACTIVE"
                android:textColor="#10B981"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>


</RelativeLayout>